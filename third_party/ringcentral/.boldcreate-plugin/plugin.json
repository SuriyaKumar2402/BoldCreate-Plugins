{
  "$schema": "../../../schemas/boldcreate-plugin.schema.json",
  "name": "ringcentral",
  "displayName": "RingCentral",
  "version": "0.1.0",
  "description": "Work with RingCentral phone and Team Chat: review calls, voicemail, SMS, and faxes; find colleagues; and manage messages, tasks, notes, events, teams, webhooks, and Adaptive Cards.",
  "author": {
    "name": "Syncfusion"
  },
  "homepage": "https://developers.ringcentral.com/mcp/skills/",
  "repository": "https://github.com/syncfusion/BoldCreate-Plugins",
  "license": "MIT",
  "logo": "assets/logo.svg",
  "category": "communication",
  "keywords": [
    "ringcentral",
    "ringex",
    "phone",
    "team-chat",
    "sms",
    "voicemail",
    "fax",
    "mcp",
    "skills"
  ],
  "hostedBy": "vendor",
  "stage": "preview",
  "docs": "https://developers.ringcentral.com/mcp/skills/",
  "upstream": {
    "repository": "https://github.com/ringcentral/ringex-claude-plugin",
    "path": "skills",
    "commit": "7e44d617023d415e377d684e00abc778e6336f07",
    "author": "RingCentral",
    "license": "MIT"
  },
  "rollout": {
    "phase": 1,
    "wave": "B"
  },
  "supportedByGateway": true,
  "variables": {},
  "components": {
    "mcp": [
      {
        "name": "ringcentral-phone",
        "transport": "streamable-http",
        "url": "https://mcp.labs.ringcentral.com/ringex/phone",
        "auth": {
          "type": "oauth",
          "alternatives": []
        }
      },
      {
        "name": "ringcentral-team-chat",
        "transport": "streamable-http",
        "url": "https://mcp.labs.ringcentral.com/ringex/team-chat",
        "auth": {
          "type": "oauth",
          "alternatives": []
        }
      }
    ],
    "skills": [
      "call-followup-email",
      "call-recap",
      "colleague-lookup",
      "communications-brief",
      "fax-inbox",
      "manage-adaptive-cards",
      "manage-events",
      "manage-notes",
      "manage-tasks",
      "manage-teams",
      "manage-webhooks",
      "post-to-chat",
      "read-team-chat",
      "send-sms",
      "sms-inbox",
      "voicemail-inbox"
    ],
    "rules": [],
    "hooks": [],
    "agents": [],
    "commands": []
  },
  "endpointCheck": {
    "lastLiveCheck": "2026-11-13",
    "source": "live probe of https://mcp.labs.ringcentral.com/ringex/phone and /ringex/team-chat: each unauthenticated initialize returned HTTP 401 with WWW-Authenticate Bearer and a resource_metadata link; each authorization server metadata lists a registration endpoint and S256 PKCE"
  }
}
